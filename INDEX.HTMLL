<!DOCTYPE html>
<html lang="id">
<head>
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ngopa Ngopi Ae - Tuku Kopi Murah Nak Kene</title>
    <!-- Favicon / Logo Tab Browser -->
    <link rel="icon" type="image/png" href="logo-ngopa-ngopi-ae.png">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#F2F9F4',
                            100: '#DCF0E2',
                            200: '#B8E2C5',
                            500: '#2E6F40',
                            700: '#1B4326',
                            800: '#14331C',
                            900: '#0D2213',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-thumb { background: #2E6F40; border-radius: 10px; }
        ::-webkit-scrollbar-track { background: #F2F9F4; }
        .glass-nav { backdrop-filter: blur(12px); background-color: rgba(20, 51, 28, 0.95); }
        
        /* FIX KONTRAS WAKTU NIGHT MODE (DARK THEME) */
        .dark-theme { background-color: #0B190E !important; color: #ffffff !important; }
        .dark-theme .bg-white { background-color: #14331C !important; color: #ffffff !important; border-color: #2E6F40 !important; }
        .dark-theme .text-brand-900 { color: #ffffff !important; }
        .dark-theme .text-brand-800 { color: #fde047 !important; }
        .dark-theme .text-gray-700, .dark-theme .text-gray-600 { color: #e5e7eb !important; }
        .dark-theme .text-gray-500, .dark-theme .text-gray-400 { color: #9ca3af !important; }
        .dark-theme .bg-brand-50 { background-color: #14331C !important; color: #ffffff !important; }
        .dark-theme .border-brand-100, .dark-theme .border-brand-200 { border-color: #2E6F40 !important; }
        .dark-theme input, .dark-theme select { background-color: #1B4326 !important; color: #ffffff !important; border-color: #2E6F40 !important; }
        
        /* Animasi Transisi Grid Menu & Brand */
        .menu-animate-enter {
            opacity: 1 !important;
            transform: scale(1) translateY(0) !important;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }
        .menu-animate-leave {
            opacity: 0 !important;
            transform: scale(0.96) translateY(8px) !important;
            transition: opacity 0.15s ease, transform 0.15s ease;
        }
    </style>
</head>
<body id="mainBody" class="bg-brand-50 text-brand-900 font-sans pb-24 md:pb-8 transition-colors duration-300">

    <!-- Notifikasi Mengapung Pojok Kanan Atas -->
    <div id="toastNotification" class="fixed top-20 right-4 z-50 bg-brand-900 text-white border-2 border-amber-400 px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-2.5 transition-all duration-300 transform translate-x-full opacity-0">
        <i class="fa-solid fa-circle-check text-amber-400 text-lg"></i>
        <span class="text-xs font-black" id="toastMessage">Item sudah dimasukkan ke keranjang</span>
    </div>

    <!-- Top Navigation -->
    <header class="sticky top-0 z-40 glass-nav text-white shadow-md">
        <div class="max-w-4xl mx-auto px-4 py-2.5 flex items-center justify-between">
            <div class="flex items-center space-x-10">
                <!-- Logo Header Statis -->
                <img src="logo-ngopa-ngopi-ae.png" alt="Ngopa Ngopi Ae Logo" class="h-11 w-auto object-contain">
                <div>
                    <h1 class="font-black text-lg leading-tight text-white tracking-wide">Ngopa Ngopi Ae</h>
                    <p class="text-xs text-brand-1100 flex items-center gap-2 cursor-pointer" onclick="openModal('outletModal')">
                        <i class="fa-solid font-bold text-amber-400 fa-location-dot"></i> 
                        <span data-i18n="warn_outlet"id="currentOutletName" class="underline decoration-dotted font-semibold">CARI LOKASI OUTLET TERDEKAT DI AREAMU</span> 
                        <i class="fa-solid fa-chevron-down text-[5px]"></i>
                    </p>
                </div>
            </div>
            <!-- TEMPELKAN DI HEADER SAMPING IKON BULAN / KERANJANG -->
<div class="relative inline-block">
    <button type="button" onclick="toggleLanguageDropdown()" id="langBtn" class="flex items-center gap-1.5 px-3 py-1.5 bg-brand-800/80 hover:bg-brand-700 text-white rounded-xl text-xs font-bold border border-brand-700 transition cursor-pointer">
        <span id="currentLangFlag">🇮🇩</span>
        <span id="currentLangCode">ID</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
    </button>

    <div id="langDropdown" class="hidden absolute right-0 mt-1.5 w-32 bg-white rounded-xl shadow-xl border border-gray-100 py-1 z-50 text-gray-800 text-xs font-semibold">
        <button type="button" onclick="setLanguage('id')" class="w-full text-left px-3 py-2 hover:bg-emerald-50 hover:text-emerald-700 flex items-center gap-2 cursor-pointer">
            <span>🇮🇩</span> Indonesia
        </button>
        <button type="button" onclick="setLanguage('en')" class="w-full text-left px-3 py-2 hover:bg-emerald-50 hover:text-emerald-700 flex items-center gap-2 cursor-pointer">
            <span>🇬🇧</span> English
        </button>
    </div>
</div>
            <div class="flex items-center space-x-2">
                <!-- Mode Night / Light Toggle Button -->
                <button onclick="toggleTheme()" class="p-2.5 bg-brand-700 hover:bg-brand-500 rounded-xl transition border border-brand-500/30 text-white" title="Ganti Mode Terang/Gelap">
                    <i id="themeIcon" class="fa-solid fa-moon text-lg"></i>
                </button>

                <button onclick="openModal('cartModal')" class="relative p-2.5 bg-brand-700 hover:bg-brand-500 rounded-xl transition border border-brand-500/30">
                    <i class="fa-solid fa-cart-shopping text-white text-lg"></i>
                    <span id="cartCount" class="absolute -top-1.5 -right-1.5 bg-amber-400 text-brand-900 font-black text-xs w-5 h-5 rounded-full flex items-center justify-center hidden shadow">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Banner Info & Branding Header -->
    <section class="max-w-4xl mx-auto p-4">
        <div class="bg-gradient-to-br from-brand-800 to-brand-900 text-white rounded-3xl p-6 shadow-xl border border-brand-700 relative overflow-hidden text-center md:text-left md:flex md:items-center md:justify-between gap-6">
            <div class="relative z-10 flex-1">
                <div class="inline-flex items-center gap-2 bg-amber-400 text-brand-900 text-xs font-black px-3 py-1 rounded-full uppercase tracking-wider mb-2">
                    <i class="fa-solid fa-bolt"></i> PROSES SATSET WATWET
                </div>
                <h2 data-i18n="hero_title" class="text-2xl md:text-3xl font-extrabold tracking-tight">Tuku Kopi Murah Nak Kene Yo!</h2>
                <p data-i18n="hero_desc" class="text-xs md:text-sm text-brand-100 mt-2 max-w-lg leading-relaxed">
                    Pesen kopi senenganmu hemat kanthi rega pas bendino. Gausah antri, gak kesuen, wes ndang pesen yo!
                </p>
                
                <div class="mt-4 flex flex-wrap justify-center md:justify-start gap-2">
                    <button onclick="openModal('panduanOrderModal')" class="bg-brand-700 hover:bg-brand-500 text-xs font-bold px-3.5 py-2 rounded-xl border border-brand-500/40 text-white transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-route text-amber-400"></i> Carane Pesen
                    </button>
                    <button onclick="openModal('paymentInfoModal')" class="bg-brand-700 hover:bg-brand-500 text-xs font-bold px-3.5 py-2 rounded-xl border border-brand-500/40 text-white transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-wallet text-amber-400"></i> Mbayar
                    </button>
                    <button onclick="openModal('wifiModal')" class="bg-brand-700 hover:bg-brand-500 text-xs font-bold px-3.5 py-2 rounded-xl border border-brand-500/40 text-white transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-wifi text-amber-400"></i> WiFi Dino Iki
                    </button>
                </div>
            </div>

            <div class="mt-4 md:mt-0 flex justify-center shrink-0">
                <img src="logo-ngopa-ngopi-ae.png" alt="Logo Big" class="w-32 md:w-40 h-auto drop-shadow-2xl object-contain">
            </div>
        </div>
    </section>

    <!-- Main Content Container -->
    <main class="max-w-4xl mx-auto px-4">
        
        <!-- Brand Picker Section dengan Source Logo Lokal -->
        <div class="mb-5">
            <h3 class="text-xs md:text-sm font-black mb-2 flex items-center gap-1.5">Pilih Brand Favoritmu <span class="text-amber-500">➔</span></h3>
            <div class="grid grid-cols-3 gap-2 md:gap-3" id="brandContainer">
                <div onclick="selectBrand('Kopi Kenangan')" id="brand-Kopi-Kenangan" class="brand-card p-3 rounded-2xl border-2 cursor-pointer transition-all duration-300 active:scale-95 flex flex-col justify-between bg-white border-brand-500 shadow-md">
                    <div class="flex items-center gap-2">
                        <img src="logo-kopi-kenangan.png" alt="Kopi Kenangan" class="w-7 h-7 rounded-lg object-contain bg-amber-50">
                        <div>
                            <h4 class="font-extrabold text-xs">Kopi Kenangan</h4>
                            
                        </div>
                    </div>
                </div>
                <div onclick="selectBrand('Tomoro Coffee')" id="brand-Tomoro-Coffee" class="brand-card p-3 rounded-2xl border-2 cursor-pointer transition-all duration-300 active:scale-95 flex flex-col justify-between bg-white border-brand-200 opacity-60 hover:opacity-100">
                    <div class="flex items-center gap-2">
                        <img src="logo-tomoro-coffee.png" alt="Tomoro Coffee" class="w-7 h-7 rounded-lg object-contain bg-red-50">
                        <div>
                            <h4 class="font-extrabold text-xs">Tomoro Coffee</h4>
                           
                        </div>
                    </div>
                </div>
                <div onclick="selectBrand('Fore Coffee')" id="brand-Fore-Coffee" class="brand-card p-3 rounded-2xl border-2 cursor-pointer transition-all duration-300 active:scale-95 flex flex-col justify-between bg-white border-brand-200 opacity-60 hover:opacity-100">
                    <div class="flex items-center gap-2">
                        <img src="logo-fore-coffee.png" alt="Fore Coffee" class="w-7 h-7 rounded-lg object-contain bg-emerald-50">
                        <div>
                            <h4 class="font-extrabold text-xs">Fore Coffee</h4>
                                                    </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search & Filter Category -->
        <div class="mb-5">
            <div class="relative mb-3">
                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-brand-500"></i>
                <input type="text" id="searchInput" oninput="filterMenu()" placeholder="Nggolek kopi, jajanan, utowo ombean senenganmu biasane..." 
                    class="w-full pl-11 pr-4 py-3 rounded-2xl border-2 border-brand-200 focus:outline-none focus:border-brand-500 bg-white shadow-sm text-sm font-medium transition">
            </div>

            <!-- Categories Tabs -->
            <div class="flex space-x-2 overflow-x-auto pb-2 scrollbar-none" id="categoryContainer"></div>
        </div>

        <!-- Menu List Grid dengan Transisi Animasi -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 transition-all duration-300 menu-animate-enter" id="menuGrid"></div>
    </main>

    <!-- Footer Banner / Trust Badge -->
    <footer class="max-w-4xl mx-auto px-4 mt-8 mb-4">
        <div class="bg-brand-100 border border-brand-200 rounded-2xl p-3 flex justify-around items-center text-center text-[11px] font-bold text-brand-800">
            <span class="flex items-center gap-1"><i class="fa-solid fa-shield-halved text-brand-500"></i> AMAN LAN ISO DIPERCOYO</span>
            <span class="text-brand-300">|</span>
            <span class="flex items-center gap-1"><i class="fa-solid fa-bolt text-brand-500"></i> PROSES SATSET WATWET</span>
            <span class="text-brand-300">|</span>
            <span class="flex items-center gap-1"><i class="fa-solid fa-store text-brand-500"></i> CEMEPAK ING OUTLET LAN APLIKASI</span>
        </div>
    </footer>

    <!-- Floating Mobile Bottom Nav -->
    <div class="fixed bottom-0 left-0 right-0 glass-nav border-t border-brand-700 p-2.5 md:hidden z-30">
        <div class="max-w-4xl mx-auto flex justify-around items-center text-white text-[11px]">
            <button onclick="window.scrollTo({top:0, behavior:'smooth'})" class="flex flex-col items-center text-amber-400 font-bold">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="mt-0.5">Ngarepanmu</span>
            </button>
            <button onclick="openModal('panduanOrderModal')" class="flex flex-col items-center text-brand-200">
                <i class="fa-solid fa-list-check text-lg"></i>
                <span class="mt-0.5">Carane Pesen</span>
            </button>
            <button onclick="openModal('paymentInfoModal')" class="flex flex-col items-center text-brand-200">
                <i class="fa-solid fa-credit-card text-lg"></i>
                <span class="mt-0.5">Mbayar</span>
            </button>
            <button onclick="openModal('cartModal')" class="flex flex-col items-center text-amber-400 font-black relative">
                <i class="fa-solid fa-bag-shopping text-lg"></i>
                <span class="mt-0.5">Kresegmu</span>
                <span id="mobileCartBadge" class="absolute -top-1.5 right-1 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center hidden">0</span>
            </button>
        </div>
    </div>

    <!-- MODAL: Customization Item Regular -->
    <div id="itemDetailModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-end md:items-center justify-center hidden">
        <div class="bg-brand-900 text-white w-full max-w-md rounded-t-3xl md:rounded-3xl max-h-[90vh] flex flex-col p-5 shadow-2xl border border-brand-700 overflow-y-auto">
            <div class="flex justify-between items-start pb-3 border-b border-brand-700">
                <div>
                    <h3 id="modalItemTitle" class="font-black text-lg text-white"></h3>
                    <p id="modalItemPrice" class="text-sm font-bold text-amber-400"></p>
                </div>
                <button onclick="closeModal('itemDetailModal')" class="text-gray-400 hover:text-white text-2xl font-bold">&times;</button>
            </div>

            <div class="py-4 space-y-4 text-xs">
                <!-- Size Options -->
                <div id="sizeSection">
                    <label class="block text-gray-300 font-bold mb-2 uppercase tracking-wider text-[10px]">SIZE</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" onclick="selectOption('size', 'Regular', 0)" id="opt-size-Regular" class="size-btn py-2.5 px-3 rounded-xl border font-extrabold text-center transition">Regular</button>
                        <button type="button" onclick="selectOption('size', 'Large', 5000)" id="opt-size-Large" class="size-btn py-2.5 px-3 rounded-xl border font-extrabold text-center transition">Large (+5.000)</button>
                    </div>
                </div>

                <!-- Temperature Options -->
                <div id="tempSection">
                    <label class="block text-gray-300 font-bold mb-2 uppercase tracking-wider text-[10px]">TEMPERATURE</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" onclick="selectOption('temp', 'Ice', 0)" id="opt-temp-Ice" class="temp-btn py-2.5 px-3 rounded-xl border font-extrabold text-center transition">Ice</button>
                        <button type="button" onclick="selectOption('temp', 'Hot', 0)" id="opt-temp-Hot" class="temp-btn py-2.5 px-3 rounded-xl border font-extrabold text-center transition">Hot</button>
                    </div>
                </div>

                <!-- Ice Level Options -->
                <div id="iceSection">
                    <label class="block text-gray-300 font-bold mb-2 uppercase tracking-wider text-[10px]">ICE LEVEL</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" onclick="selectOption('ice', 'Normal Ice', 0)" id="opt-ice-NormalIce" class="ice-btn py-2 px-2 rounded-xl border font-extrabold text-center transition">Normal</button>
                        <button type="button" onclick="selectOption('ice', 'Less Ice', 0)" id="opt-ice-LessIce" class="ice-btn py-2 px-2 rounded-xl border font-extrabold text-center transition">Less Ice</button>
                        <button type="button" onclick="selectOption('ice', 'No Ice', 0)" id="opt-ice-NoIce" class="ice-btn py-2 px-2 rounded-xl border font-extrabold text-center transition">No Ice</button>
                    </div>
                </div>

                <!-- Sugar Level Options -->
                <div id="sugarSection">
                    <label class="block text-gray-300 font-bold mb-2 uppercase tracking-wider text-[10px]">SUGAR LEVEL</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" onclick="selectOption('sugar', 'Normal Sugar', 0)" id="opt-sugar-NormalSugar" class="sugar-btn py-2 px-2 rounded-xl border font-extrabold text-center transition">Normal</button>
                        <button type="button" onclick="selectOption('sugar', 'Less Sugar', 0)" id="opt-sugar-LessSugar" class="sugar-btn py-2 px-2 rounded-xl border font-extrabold text-center transition">Less Sugar</button>
                        <button type="button" onclick="selectOption('sugar', 'No Sugar', 0)" id="opt-sugar-NoSugar" class="sugar-btn py-2 px-2 rounded-xl border font-extrabold text-center transition">No Sugar</button>
                    </div>
                </div>

                <!-- Notes Input -->
                <div>
                    <label class="block text-gray-300 font-bold mb-1 uppercase tracking-wider text-[10px]">Catatan Tambahan:</label>
                    <input type="text" id="modalItemNote" placeholder="Catatan tambahan..." class="w-full p-3 rounded-xl bg-brand-800 border border-brand-700 text-white focus:outline-none focus:border-amber-400">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 pt-3 border-t border-brand-700">
                <button type="button" onclick="closeModal('itemDetailModal')" class="py-3 bg-brand-800 hover:bg-brand-700 text-gray-300 font-extrabold rounded-xl transition text-xs">Batal</button>
                <button type="button" onclick="confirmAddToCart()" id="btnConfirmAdd" class="py-3 bg-amber-400 hover:bg-amber-300 text-brand-900 font-extrabold rounded-xl transition text-xs shadow-lg">Tambah</button>
            </div>
        </div>
    </div>

    <!-- MODAL POPUP KHUSUS PAKET HEMAT / BUNDLING MULTI-SLOT -->
    <div id="bundlingModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-end md:items-center justify-center hidden">
        <div class="bg-brand-900 text-white w-full max-w-lg rounded-t-3xl md:rounded-3xl max-h-[90vh] flex flex-col p-5 shadow-2xl border border-brand-700 overflow-y-auto">
            <div class="flex justify-between items-start pb-3 border-b border-brand-700">
                <div>
                    <h3 id="bundlingTitle" class="font-black text-lg text-white"></h3>
                    <p id="bundlingSub" class="text-xs text-gray-300 mt-0.5"></p>
                    <p id="bundlingPrice" class="text-sm font-black text-amber-400 mt-1"></p>
                </div>
                <button onclick="closeModal('bundlingModal')" class="text-gray-400 hover:text-white text-2xl font-bold">&times;</button>
            </div>

            <div class="my-3 flex gap-2 overflow-x-auto pb-1" id="bundlingSlotsContainer"></div>

            <div class="my-2">
                <p class="text-xs font-bold text-gray-300 mb-2">Pilihan Menu (Pilih untuk Slot Aktif):</p>
                <div class="grid grid-cols-4 gap-4 max-h-48 overflow-y-auto pr-1" id="bundlingItemGrid"></div>
            </div>

            <div id="bundlingCustomizeArea" class="bg-brand-800/80 p-3 rounded-2xl border border-brand-700 my-2 hidden text-xs space-y-3">
                <p class="font-extrabold text-amber-400 text-[11px]" id="selectedSlotItemName"></p>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-gray-300 font-bold mb-1 text-[9px] uppercase">TEMPERATURE</label>
                        <select id="bundleTempSelect" class="w-full p-2 bg-brand-900 border border-brand-700 rounded-xl text-white">
                            <option value="Ice">Ice</option>
                            <option value="Hot">Hot</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-gray-300 font-bold mb-1 text-[9px] uppercase">SUGAR LEVEL</label>
                        <select id="bundleSugarSelect" class="w-full p-2 bg-brand-900 border border-brand-700 rounded-xl text-white">
                            <option value="Normal Sugar">Normal Sugar</option>
                            <option value="Less Sugar">Less Sugar</option>
                            <option value="No Sugar">No Sugar</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-gray-300 font-bold mb-1 text-[9px] uppercase">ICE LEVEL</label>
                    <select id="bundleIceSelect" class="w-full p-2 bg-brand-900 border border-brand-700 rounded-xl text-white">
                        <option value="Normal Ice">Normal Ice</option>
                        <option value="Less Ice">Less Ice</option>
                        <option value="No Ice">No Ice</option>
                    </select>
                </div>
                <button onclick="confirmSlotSelection()" class="w-full py-2 bg-amber-400 text-brand-900 font-extrabold rounded-xl text-xs hover:bg-amber-300 transition">Konfirmasi Pilihan Slot</button>
            </div>

            <div class="mt-2">
                <label class="block text-gray-300 font-bold mb-1 text-[10px]">Catatan tambahan untuk bundling ini:</label>
                <input type="text" id="bundlingNoteInput" placeholder="Contoh: Tanpa sedotan / pisah es..." class="w-full p-2.5 rounded-xl bg-brand-800 border border-brand-700 text-white text-xs">
            </div>

            <div class="grid grid-cols-2 gap-3 pt-4 border-t border-brand-700 mt-4">
                <button type="button" onclick="closeModal('bundlingModal')" class="py-3 bg-brand-800 text-gray-300 font-extrabold rounded-xl text-xs">Batal</button>
                <button type="button" onclick="confirmAddBundlingToCart()" id="btnConfirmBundling" class="py-3 bg-amber-400 text-brand-900 font-black rounded-xl text-xs shadow-lg">Tambah ke Keranjang</button>
            </div>
        </div>
    </div>

    <!-- MODAL: Ganti Brand Alert -->
    <div id="changeBrandModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-brand-900 text-white w-full max-w-sm rounded-3xl p-5 shadow-2xl border border-brand-700 text-center">
            <i class="fa-solid fa-triangle-exclamation text-amber-400 text-3xl mb-2"></i>
            <h3 class="font-extrabold text-base text-white mb-1">Ganti Brand?</h3>
            <p class="text-xs text-gray-300 mb-4 leading-relaxed">Keranjangmu berisi item dari brand yang berbeda. Melanjutkan akan mereset keranjang.</p>
            <div class="space-y-2">
                <button onclick="confirmChangeBrand()" class="w-full py-3 bg-amber-400 hover:bg-amber-300 text-brand-900 font-black rounded-xl text-xs transition">Ya, Ganti Brand</button>
                <button onclick="closeModal('changeBrandModal')" class="w-full py-2.5 bg-brand-800 hover:bg-brand-700 text-gray-300 font-bold rounded-xl text-xs transition">Batal</button>
            </div>
        </div>
    </div>

    <!-- MODAL: Outlet Picker -->
