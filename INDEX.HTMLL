        </div>

        <label class="flex items-center gap-2 text-xs text-gray-600 cursor-pointer select-none mb-4 w-full justify-start pl-1">
            <input type="checkbox" id="chkHideWelcomeNotice" class="w-4 h-4 rounded text-emerald-600 border-gray-300">
            <span>Jangan tampilkan lagi</span>
        </label>

        <button type="button" 
    onclick="document.getElementById('welcomeNoticeModal').style.display='none'; if(document.getElementById('chkHideWelcomeNotice')?.checked){localStorage.setItem('hideNgopaNotice','true');}" 
    class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold rounded-2xl transition shadow-lg text-sm cursor-pointer">
    Saya Mengerti
</button>
    </div>
</div>

